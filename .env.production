# ============================================================================
# CONFIGURACIÓN PARA PRODUCCIÓN - ZooConnect
# ============================================================================
# BASE DE DATOS - Usar la URL de Railway/Render
DATABASE_URL=postgresql+psycopg2://postgres:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# SEGURIDAD
SECRET_KEY=${SECRET_KEY_PROD}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=100
REFRESH_TOKEN_EXPIRE_DAYS=5

# RUTAS
MEDIA_DIR=./media

# CORS - Permitir todas las URLs de Vercel y producción
CORS_ORIGINS=["https://zoo-connect-completo.vercel.app","https://www.zoo-connect-completo.vercel.app","https://vercel-zoo-connect.vercel.app","https://zoo-connect-vercel.vercel.app","${FRONTEND_URL}"]

# FRONTEND URL PARA RESET DE CONTRASEÑA
FRONTEND_RESET_PASSWORD_URL=${FRONTEND_URL}/reset-password

# AUTENTICACIÓN 2FA
TOTP_ENCRYPTION_KEY=${TOTP_ENCRYPTION_KEY}

# REDIS - Usar la URL de Railway/Render
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT}
REDIS_DB=0

# CORREO - Usar Postmark (recomendado para producción)
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_FROM=${MAIL_FROM}
MAIL_FROM_NAME=Soporte ZooConnect
MAIL_PORT=587
MAIL_SERVER=smtp.postmarkapp.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# CREDENCIALES ADMIN POR DEFECTO
DEFAULT_ADMIN_EMAIL=${DEFAULT_ADMIN_EMAIL}
DEFAULT_ADMIN_PASSWORD=${DEFAULT_ADMIN_PASSWORD}
DEFAULT_ADMIN_PHONE=${DEFAULT_ADMIN_PHONE}

# TEXTBEE SMS
TEXTBEE_API_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_API_KEY=${TEXTBEE_API_KEY}
TEXTBEE_DEVICE_ID=${TEXTBEE_DEVICE_ID}
SMS_OTP_EXPIRE_MINUTES=10

# CLOUDINARY - Para manejo de imágenes
CLOUDINARY_CLOUD_NAME=${CLOUDINARY_CLOUD_NAME}
CLOUDINARY_API_KEY=${CLOUDINARY_API_KEY}
CLOUDINARY_API_SECRET=${CLOUDINARY_API_SECRET}

# POSTMARK - Token del servidor
POSTMARK_SERVER_TOKEN=${POSTMARK_SERVER_TOKEN}

# RECAPTCHA - Google v2
RECAPTCHA_SITE_KEY=${RECAPTCHA_SITE_KEY}
RECAPTCHA_SECRET_KEY=${RECAPTCHA_SECRET_KEY}

# PORT (automático en Railway/Render)
PORT=8000
